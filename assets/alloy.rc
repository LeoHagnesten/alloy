#include <windows.h>
#include "version.hh"

1 ICON "alloy.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "alloy.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION ALLOY_VERSION
PRODUCTVERSION ALLOY_VERSION
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904B0"
		BEGIN
			VALUE "CompanyName", "Alloy"
			VALUE "FileDescription", "Alloy miner"
			VALUE "FileVersion", ALLOY_VERSION_TEXT
			VALUE "InternalName", "Alloy"
			VALUE "ProductName", "Alloy"
			VALUE "ProductVersion", ALLOY_VERSION_TEXT
			VALUE "OriginalFilename", "Alloy.exe"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
